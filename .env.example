# Gemini-Remote 示例配置，只含假值。
# 本机首次使用优先运行 `uv run gemini-remote init-local` 生成 .env（不会覆盖、不会打印 token）。
# 这里只放本应用自己的总线凭证；绝不放 Google 登录态、cookie 或密码。

GEMINI_REMOTE_CONTROL_TOKEN=replace-with-random-32-plus-character-control-token
GEMINI_REMOTE_DEVICE_TOKEN=replace-with-random-32-plus-character-device-token
GEMINI_REMOTE_SIGNING_KEY=replace-with-independent-random-32-plus-character-signing-key
GEMINI_REMOTE_BROWSER_TOKEN=replace-with-local-browser-pairing-token
GEMINI_REMOTE_DEVICE_ID=owner-pc
GEMINI_REMOTE_GATEWAY_URL=wss://gateway.example.com/ws/device
GEMINI_REMOTE_DATA_DIR=.data

# 分角色保留：
# - VPS Gateway：只保留 CONTROL_TOKEN、DEVICE_TOKEN、SIGNING_KEY，不放 BROWSER_TOKEN。
# - 本机 Relay：只保留 DEVICE_TOKEN、SIGNING_KEY、BROWSER_TOKEN，不放 CONTROL_TOKEN。
