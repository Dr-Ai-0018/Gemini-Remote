{
  "manifest_version": 3,
  "name": "Gemini Remote Browser Bridge",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Owner-local Gemini page adapter. Never reads Google credentials or cookies.",
  "key": "Z2VtaW5pLXJlbW90ZS10ZXN0LWtleQ==",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "all_frames": false,
      "run_at": "document_idle",
      "js": [
        "selectors.js",
        "content-entry.js"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:18776"
  }
}
