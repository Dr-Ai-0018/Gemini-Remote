{
  "manifest_version": 3,
  "name": "Gemini Remote Browser Bridge",
  "version": "0.1.4",
  "minimum_chrome_version": "116",
  "description": "Lets the local Gemini-Remote Relay drive your logged-in Gemini tab. Pairs with the Relay by a one-time code; never reads Google credentials or cookies.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Gemini Remote",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "all_frames": false,
      "run_at": "document_idle",
      "js": [
        "selectors.js",
        "panel.js",
        "content-entry.js"
      ]
    }
  ]
}
