{
  "manifest_version": 3,
  "name": "Gemini Remote Browser Bridge",
  "version": "0.1.2",
  "minimum_chrome_version": "116",
  "description": "Local Gemini page adapter. Never reads Google credentials or cookies.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "all_frames": false,
      "run_at": "document_idle",
      "js": [
        "selectors.js",
        "content-entry.js"
      ]
    }
  ]
}
